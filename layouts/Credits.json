			"instances": [
				{
					"type": "Creditos",
					"properties": {
						"text": "\n\nUM JOGO DESENVOLVIDO POR:\n\n\nCAYKE GONÇALVES GARCIA\n\nDAVI FIGUEIREDO ROCHA DUTRA\n\nJÚLIA DA SILVA SANTOS\n\nHEITOR FRANCISCO RIBEIRO\n\nKAUÃ AMORIM DE OLIVEIRA\n\n━━━━━━━━━━━━━━━━\n\nPROGRAMAÇÃO:\n\n\nCAYKE GONÇALVES GARCIA\n\nDAVI FIGUEIREDO ROCHA DUTRA\n\nJÚLIA DA SILVA SANTOS\n\nHEITOR FRANCISCO RIBEIRO\n\nKAUÃ AMORIM DE OLIVEIRA\n\n━━━━━━━━━━━━━━━━\n\nCRIAÇÃO DAS FASES:\n\n\nCAYKE GONÇALVES GARCIA\n\nDAVI FIGUEIREDO ROCHA DUTRA\n\nJÚLIA DA SILVA SANTOS\n\nHEITOR FRANCISCO RIBEIRO\n\nKAUÃ AMORIM DE OLIVEIRA\n\n━━━━━━━━━━━━━━━━\n\nARTES E DESIGN:\n\n\nCAYKE GONÇALVES GARCIA\n\nDAVI FIGUEIREDO ROCHA DUTRA\n\nJÚLIA DA SILVA SANTOS\n\nHEITOR FRANCISCO RIBEIRO\n\nKAUÃ AMORIM DE OLIVEIRA\n\n━━━━━━━━━━━━━━━━\n\nMÚSICAS E EFEITOS SONOROS:\n\n\nCAYKE GONÇALVES GARCIA\n\nDAVI FIGUEIREDO ROCHA DUTRA\n\nJÚLIA DA SILVA SANTOS\n\nHEITOR FRANCISCO RIBEIRO\n\nKAUÃ AMORIM DE OLIVEIRA\n\n━━━━━━━━━━━━━━━━\n\nTESTES E BALANCEAMENTO:\n\n\nCAYKE GONÇALVES GARCIA\n\nDAVI FIGUEIREDO ROCHA DUTRA\n\nJÚLIA DA SILVA SANTOS\n\nHEITOR FRANCISCO RIBEIRO\n\nKAUÃ AMORIM DE OLIVEIRA\n\n━━━━━━━━━━━━━━━━\n\nFERRAMENTAS UTILIZADAS:\n\n\nCONSTRUCT 3\nPHOTOSHOP\nAUDACITY\nCHATGPT\nGEMINI\nCLAUDE\n\n━━━━━━━━━━━━━━━━\n\nAGRADECIMENTOS ESPECIAIS:\n\nA TODOS QUE JOGARAM,\nTESTARAM E APOIARAM ESTE PROJETO.\n\nAO NOSSO PROFESSOR NÍCOLLAS NOGUEIRA CRETTON,\nCOLEGAS E FAMILIARES,\nPELO INCENTIVO E APOIO.\n\nOBRIGADO POR FAZER PARTE\nDESTA JORNADA.\n",
